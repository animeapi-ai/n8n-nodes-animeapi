{
	"name": "n8n-nodes-animeapi",
	"version": "0.1.1",
	"description": "n8n community node for AnimeAPI: anime image generation at $0.003 per image, and anime video clips.",
	"license": "MIT",
	"homepage": "https://animeapi.ai",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"animeapi",
		"anime",
		"image-generation",
		"text-to-image",
		"ai"
	],
	"author": {
		"name": "AnimeAPI",
		"email": "contact@animeapi.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/animeapi-ai/n8n-nodes-animeapi.git"
	},
	"bugs": {
		"url": "https://github.com/animeapi-ai/n8n-nodes-animeapi/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AnimeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AnimeApi/AnimeApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
